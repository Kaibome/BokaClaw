OPENAI_API_KEY=

# Optional: other bundled LLM/embedder providers (set the key for the one you want to use)
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3000
APP_DB_NAME=mem0_app

# Default LLM and embedder models. Provider must be in BUNDLED_*_PROVIDERS
# (see server/main.py). Override to pin a specific model without editing code.
MEM0_DEFAULT_LLM_MODEL=gpt-5-mini
MEM0_DEFAULT_EMBEDDER_MODEL=text-embedding-3-small
# Persist the fastembed ONNX cache. The default is /tmp/fastembed_cache, which
# is container-local, so every container recreate re-downloads ~95 MB. The
# local Docker stack sets this to /app/history/fastembed on the history volume.
# FASTEMBED_CACHE_PATH=/app/history/fastembed

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Set to false to opt out.
MEM0_TELEMETRY=true

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30

# ---- Agent chat ----
# POST /agent runs the bundled bokaclaw-agent ReAct runtime in-process. It
# reuses the LLM configured for mem0 (provider openai or deepseek), so no extra
# settings are needed when OPENAI_API_KEY or DEEPSEEK_API_KEY is set. Override
# with AGENT_MODEL / AGENT_API_KEY / AGENT_BASE_URL for another OpenAI-compatible
# endpoint (Qwen, vLLM, Ollama, OpenRouter, ...).
# AGENT_MODEL=
# AGENT_API_KEY=
# AGENT_BASE_URL=
# AGENT_SYSTEM_PROMPT=
AGENT_MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.2
# AGENT_MAX_TOKENS=
AGENT_REQUEST_TIMEOUT_SECONDS=60
AGENT_MAX_RETRIES=2
# Model-view limits for long tool runs. Full tool results and stored messages
# are unaffected; only what is sent to the model changes. Set a budget to 0/off
# to disable it. Compression keeps half the budget verbatim by default.
AGENT_CONTEXT_MAX_TOKENS=32000
# AGENT_CONTEXT_KEEP_RECENT_TOKENS=
# summary (model summary, truncation fallback) or truncate (drop only).
AGENT_CONTEXT_COMPRESSION=summary
AGENT_TOOL_RESULT_MAX_CHARS=16000
# Run-scoped ledger of tool calls and findings, appended after compression so
# early facts are not summarized away. Set to false to disable.
AGENT_FACT_LEDGER=true
AGENT_FACT_LEDGER_MAX_CHARS=2500
# Append "Step X of N" and a wrap-up directive near the step limit.
AGENT_STEP_BUDGET_NOTICE=true
# Detect tool calls that return no new evidence: nudge after N consecutive
# calls, then force a final answer after M. Set AGENT_PROGRESS_GUARD=false to
# disable.
AGENT_PROGRESS_GUARD=true
AGENT_PROGRESS_NUDGE_AFTER=3
AGENT_PROGRESS_STOP_AFTER=5
# Save completed web-research conclusions (answer + sources + capture time) to
# mem0, and offer fresh similar conclusions on later questions. The model is
# told they may be stale and should re-verify when facts can change. Set to
# false to disable both storing and retrieval.
AGENT_RESEARCH_MEMORY=true
# Saved conclusions older than this many days are ignored.
AGENT_RESEARCH_MEMORY_TTL_DAYS=30
# Minimum similarity (0-1) before a saved conclusion is offered.
AGENT_RESEARCH_MEMORY_MIN_SCORE=0.5
# Log the resolved model-view settings once per turn and every compression
# decision (context_compressed: before/after tokens, dropped messages, whether a
# summary was used) at INFO. Diagnostics only; the event is never sent to the
# client. On by default; set to 0/false/no/off to silence.
AGENT_CONTEXT_DEBUG=1
# When the step budget runs out while the model is still calling tools, make one
# final tool-free request so it answers from what it already gathered. Set false
# to fail the turn with "exceeded the maximum number of steps" instead.
AGENT_FINAL_ANSWER_ON_MAX_ITERATIONS=true

# ---- Agent developer tools ----
# File/search/web tools are on by default and confined to AGENT_WORKSPACE_ROOT.
# Shell access (Bash, PowerShell, Monitor) is off unless explicitly enabled.
# Point AGENT_EXECUTOR_URL at the sandboxed executor container to run shell
# commands there: it only mounts the workspace read-write, has a read-only root
# filesystem (so /app is readable but immutable), runs as a non-root user, and
# has no route off its internal Docker network. Leaving it empty runs commands
# inside the server process, where there is no sandbox.
AGENT_DEV_TOOLS=true
AGENT_WORKSPACE_ROOT=/app/workspace
AGENT_TOOLS_ALLOW_SHELL=false
# Pptx tools are registered by default; python-pptx is baked into the image.
AGENT_OFFICE_TOOLS=true
# AGENT_EXECUTOR_URL=http://bokaclaw-executor:8099
# AGENT_EXECUTOR_TOKEN=
# AGENT_EXECUTOR_TIMEOUT_SECONDS=120
AGENT_TOOL_TIMEOUT_SECONDS=120
AGENT_TOOL_MAX_OUTPUT_BYTES=200000
AGENT_TOOL_MAX_FILE_BYTES=2000000
AGENT_WEB_FETCH_TIMEOUT_SECONDS=30
AGENT_WEB_FETCH_MAX_BYTES=1000000
# Allow WebFetch and WebSearch to reach localhost / RFC1918 addresses. Keep
# false in production.
AGENT_WEB_FETCH_ALLOW_PRIVATE=false
# WebSearch uses Bing's RSS endpoint by default. Point this at a SearXNG base
# URL (e.g. https://searx.example.com) to use a different search engine.
# AGENT_WEB_SEARCH_URL=

# Optional external executor. When set, it takes precedence over the in-process
# runtime. Base URL only, without /invoke.
AGENT_LOOP_URL=
# AGENT_LOOP_API_KEY=
# Local UI development only: stream a canned reply instead of calling a model.
AGENT_LOOP_MOCK=false
AGENT_LOOP_CONNECT_TIMEOUT_SECONDS=5
AGENT_LOOP_READ_TIMEOUT_SECONDS=120
# Timeout for the legacy/remote executor path. Background runs use
# AGENT_RUN_MAX_SECONDS instead.
AGENT_LOOP_MAX_SECONDS=300
AGENT_LOOP_HISTORY_MESSAGES=40
# Replay each prior run's persisted tool calls and results into the next turn's
# model context, so the agent can reuse pages it already fetched. Set to false
# to send text-only history.
AGENT_LOOP_HISTORY_TOOL_TRACE=true
# Per-result / per-argument caps applied while replaying a trace (0 = no cap).
AGENT_LOOP_HISTORY_TOOL_RESULT_MAX_CHARS=2000
AGENT_LOOP_HISTORY_TOOL_ARGUMENT_MAX_CHARS=1000

# Background agent runs: execution survives client disconnects and is resumed
# through the run event log. Set AGENT_RUN_BACKGROUND=false to fall back to the
# request-bound path (execution stops when the connection closes).
AGENT_RUN_BACKGROUND=true
AGENT_RUN_CONCURRENCY=2
AGENT_RUN_MAX_SECONDS=1800
AGENT_RUN_HEARTBEAT_SECONDS=10
AGENT_RUN_LEASE_SECONDS=60
AGENT_RUN_EVENT_RETENTION_DAYS=7
AGENT_RUN_RETENTION_DAYS=30
AGENT_RUN_DELTA_FLUSH_MS=150
AGENT_RUN_DELTA_FLUSH_BYTES=4096

# Execution spans for offline evaluation (see docs/eval/agent-span-evaluation.md).
# Capture is a side channel: turning it off leaves agent runs unchanged.
AGENT_SPAN_CAPTURE=true
# full stores the model prompt messages in input.messages; summary keeps only
# counts/hashes for privacy-sensitive deployments.
AGENT_SPAN_PROMPT_MODE=full
AGENT_SPAN_MAX_BYTES=16384
AGENT_SPAN_SAMPLE_RATE=1.0
AGENT_SPAN_TOOL_CONTENT=true
AGENT_SPAN_RETENTION_DAYS=30

# Online evaluation (docs/eval/eval-console-design.md). Runs in the isolated
# bokaclaw-eval worker, which receives only these variables and DB credentials.
EVAL_ENABLED=true
EVAL_WORKER_ID=eval-1
EVAL_WORKER_POLL_SECONDS=2
EVAL_HEARTBEAT_SECONDS=10
EVAL_LEASE_SECONDS=60
EVAL_MAX_ATTEMPTS=3
EVAL_MAX_RUN_SECONDS=900
EVAL_RETENTION_DAYS=30
# LLM judge is opt-in per run. Leave disabled to keep prompts and tool output
# inside the deployment; enabling it sends the truncated test case to the
# provider below.
EVAL_JUDGE_ENABLED=false
EVAL_JUDGE_PROVIDER=deepseek
EVAL_JUDGE_MODEL=deepseek-chat
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_MAX_CHARS=20000
