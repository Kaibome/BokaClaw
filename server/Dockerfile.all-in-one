# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# All-in-one image: FastAPI API + Next.js dashboard + PostgreSQL 17/pgvector
# Build context: repository root. Build with:
#   docker build -f server/Dockerfile.all-in-one -t bokaclaw-all-in-one:test .
# ---------------------------------------------------------------------------

# ---- dashboard build -------------------------------------------------------
FROM node:20-bookworm-slim AS dashboard-build
ENV NEXT_TELEMETRY_DISABLED=1 \
    npm_config_registry=https://registry.npmmirror.com
WORKDIR /build

RUN npm install -g pnpm@10.34.2 --registry=https://registry.npmmirror.com

COPY dashboard/package.json dashboard/pnpm-lock.yaml dashboard/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY dashboard/ ./

# Placeholders are replaced at runtime by the entrypoint script.
ENV NEXT_PUBLIC_API_URL=NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_INSTANCE_NAME=NEXT_PUBLIC_INSTANCE_NAME
RUN pnpm run build

# ---- runtime ---------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

# Mirror used to fetch the bundled local embedding model during the build.
ARG HF_ENDPOINT=https://hf-mirror.com

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    PGDATA=/var/lib/postgresql/data \
    POSTGRES_HOST=127.0.0.1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    HF_ENDPOINT=${HF_ENDPOINT} \
    HF_HUB_DISABLE_XET=1

# PostgreSQL 17 + pgvector from PGDG (Debian bookworm)
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg gosu \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL https://apt.postgresql.org/pub/repos/apt/ACCC4CF8.asc \
         -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
         > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-17 postgresql-17-pgvector \
    && rm -rf /var/lib/apt/lists/*

# Node runtime for the Next.js standalone server (same Debian base).
COPY --from=node:20-bookworm-slim /usr/local/bin/node /usr/local/bin/node

WORKDIR /app
COPY server/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# In-process agent runtime used by POST /agent.
COPY agent-loop /opt/agent-loop
RUN pip install --no-cache-dir /opt/agent-loop

# Pre-download the bundled Chinese embedding model (~90 MB, ONNX/CPU) so the
# first request does not wait on Hugging Face. If the mirror is unreachable the
# build still succeeds and the model is fetched on first use instead.
RUN python -c "from fastembed import TextEmbedding; TextEmbedding(model_name='BAAI/bge-small-zh-v1.5')" \
    || echo "WARNING: fastembed model pre-download failed; it will be fetched at runtime"

COPY server/ .
# Drop the dashboard source; only the built standalone app is shipped.
RUN rm -rf /app/dashboard
COPY --from=dashboard-build /build/.next/standalone /app/dashboard
COPY --from=dashboard-build /build/.next/static /app/dashboard/.next/static
COPY --from=dashboard-build /build/public /app/dashboard/public

COPY server/entrypoint.all-in-one.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && mkdir -p /app/history \
    && chown -R postgres:postgres /var/lib/postgresql

EXPOSE 8000 3000

HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/docs >/dev/null \
        && curl -fsS http://127.0.0.1:3000/api/health >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
